# Supabase — stumble_brawl
# NÃO commitar chaves reais — use --dart-define ou .env local (ignorado)
# Obtenha em https://supabase.com/dashboard → Settings → API
# flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key

# Exemplos (preencha localmente, não commitar):
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbG... (anon key)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local Supabase (supabase start) — portas padrão
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<anon key de `npx supabase status`>
